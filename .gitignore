# ─── R / Quarto ──────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
.Renviron
.httr-oauth
_quarto/
_cache/
# knitted notebooks kept out of version control
*.nb.html
notes.r

# ─── Python (optional) ───────────────────────────────
__pycache__/
*.pyc
.venv/
env/
*.ipynb_checkpoints

# ─── OS / editor cruft ───────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Data & Private Folders ──────────────────────────
data/raw/
*.csv.gz
*.zip
# Files downloaded by running the demos
**/downloads/

# Quarto internal cache
/.quarto/

# Quarto rendered output dependency folders
*_files/

# Ignore cached/generated Quarto files
**/.quarto/
**/*_files/

# Ignore local notes and old material anywhere in repo
**/OLD/
**/notes/
# Keep the rendered website (GitHub Pages serves docs/)
!docs/**/*_files/

**/*.quarto_ipynb

# Output files written by running the web scraping demo
covid_*.csv
covid_*.html
!docs/**/notes/

# Old webR extension (no longer used; safe to delete these folders)
/_extensions/
/APIs/_extensions/
